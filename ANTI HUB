-- 스크립트 목록 및 URL 정의
local scriptsData = {
	{
		Name = "anti enhancement  (RIVALS)",
		Url = "https://raw.githubusercontent.com/koyo141013/anti-enhancement/refs/heads/main/anti%20enhancement"
	},
	{
		Name = "RIVALS HUB  (RIVALS)",
		Url = "https://raw.githubusercontent.com/koyo141013/RIVALS-HUB/refs/heads/main/RIVALS%20HUB"
	}
}

local selectedUrl = nil
local optionButtons = {}

-- 옵션 버튼 생성
for index, data in ipairs(scriptsData) do
	local btn = Instance.new("TextButton")
	btn.Name = "OptionBtn_" .. index
	btn.Size = UDim2.new(1, 0, 0, 45)
	btn.BackgroundColor3 = Color3.fromRGB(36, 36, 44)
	btn.Text = "   " .. data.Name
	btn.TextColor3 = Color3.fromRGB(180, 180, 190)
	btn.TextSize = 14
	btn.Font = Enum.Font.GothamMedium
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.AutoButtonColor = false
	btn.Parent = container

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = btn

	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = Color3.fromRGB(55, 55, 65)
	btnStroke.Thickness = 1
	btnStroke.Parent = btn

	btn.MouseButton1Click:Connect(function()
		selectedUrl = data.Url
		for _, otherBtn in ipairs(optionButtons) do
			TweenService:Create(otherBtn.Button, TweenInfo.new(0.2), {
				BackgroundColor3 = Color3.fromRGB(36, 36, 44),
				TextColor3 = Color3.fromRGB(180, 180, 190)
			}):Play()
			TweenService:Create(otherBtn.Stroke, TweenInfo.new(0.2), {
				Color = Color3.fromRGB(55, 55, 65)
			}):Play()
		end

		TweenService:Create(btn, TweenInfo.new(0.2), {
			BackgroundColor3 = Color3.fromRGB(45, 55, 80),
			TextColor3 = Color3.fromRGB(255, 255, 255)
		}):Play()
		TweenService:Create(btnStroke, TweenInfo.new(0.2), {
			Color = Color3.fromRGB(80, 120, 240)
		}):Play()
	end)

	table.insert(optionButtons, {Button = btn, Stroke = btnStroke})
end

