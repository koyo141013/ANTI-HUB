        Data = data,
    })
end

-- 실시간 검색 필터링
local function filterScripts()
    local query = string.lower(searchBox.Text)
    for _, entry in ipairs(scriptButtons) do
        local matches = string.find(string.lower(entry.Data.Name), query, 1, true) ~= nil
        entry.Button.Visible = matches
    end
    list.CanvasPosition = Vector2.new(0, 0)
end

searchBox:GetPropertyChangedSignal("Text"):Connect(filterScripts)

-- 실행 버튼 이벤트
executeBtn.Activated:Connect(function()
    if isExecuting then return end

    if selectedUrl then
        isExecuting = true
        executeBtn.Text = "Loading..."
        
        setStatus("Downloading script...", COLORS.Accent)
        tween(progressBarFill, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0.6, 0, 1, 0)
        })

        task.spawn(function()
            local success, result = pcall(function()
                return game:HttpGetAsync(selectedUrl)
            end)

            if success then
                setStatus("Compiling script...", COLORS.Accent)
                tween(progressBarFill, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(0.9, 0, 1, 0)
                })
                task.wait(0.2)

                local runSuccess, runErr = pcall(function()
                    loadstring(result)()
                end)

                tween(progressBarFill, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1, 0, 1, 0)
                })

                if runSuccess then
                    setStatus("Executed successfully!", COLORS.Green)
                    executeBtn.Text = "Executed!"
                else
                    warn("Script execution error:", runErr)
                    setStatus("Execution error!", COLORS.Red)
                    executeBtn.Text = "Error"
                end
            else
                warn("Download failed:", result)
                setStatus("Download failed!", COLORS.Red)
                executeBtn.Text = "Failed"
                tween(progressBarFill, TweenInfo.new(0.2), {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundColor3 = COLORS.Red
                })
            end

            task.wait(1.5)
            executeBtn.Text = "Execute"
            isExecuting = false
            tween(progressBarFill, TweenInfo.new(0.3), {
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = COLORS.Accent
            })
            setStatus("Script selected", COLORS.Green)
        end)

    else
        setStatus("Please select a script first!", COLORS.Red)
        local origPos = executeBtn.Position
        tween(executeBtn, TweenInfo.new(0.05), {Position = origPos + UDim2.new(0, -3, 0, 0)})
        task.wait(0.05)
        tween(executeBtn, TweenInfo.new(0.05), {Position = origPos + UDim2.new(0, 3, 0, 0)})
        task.wait(0.05)
        tween(executeBtn, TweenInfo.new(0.05), {Position = origPos})
    end
end)

-- 언로드(닫기) 함수 (1인칭 상태 확인 후 마우스 잠금 복구)
local function unload()
    if closed then return end
    closed = true
    dragging = false
    if dragConnection then
        dragConnection:Disconnect()
    end

    -- 1인칭 시점인지 확인 (카메라와 플레이어 머리 사이 거리가 가까우면 1인칭)
    local character = player.Character
    local head = character and character:FindFirstChild("Head")
    local isFirstPerson = false

    if head then
        local distance = (workspace.CurrentCamera.CFrame.Position - head.Position).Magnitude
        if distance < 1.0 then
            isFirstPerson = true
        end
    end

    -- 1인칭일 경우 마우스를 다시 잠금 상태(LockCenter)로 되돌림
    if isFirstPerson then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    else
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end

    tween(main, TWEEN_FAST, {
        BackgroundTransparency = 1,
        Position = main.Position + UDim2.new(0, 0, 0, 12),
    })

    task.wait(0.16)
    if screenGui.Parent then
        screenGui:Destroy()
    end
end

unloadBtn.Activated:Connect(unload)
closeButton.Activated:Connect(unload)

