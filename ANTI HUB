-- 실행 버튼 클릭 이벤트
executeBtn.MouseButton1Click:Connect(function()
	if selectedUrl then
		-- 1) 지정된 Place ID가 아닐 경우 추방
		if game.PlaceId ~= TARGET_PLACE_ID then
			Player:Kick("This script does not work in this game.")
			return
		end

		-- 2) 지정된 Place ID가 맞으면 코드 실행
		local success, err = pcall(function()
			loadstring(game:HttpGet(selectedUrl))()
		end)
		if not success then
			warn("Execute failed:", err)
		end
	else
		-- 선택된 옵션이 없을 때 흔들림 애니메이션
		local originalPos = executeBtn.Position
		TweenService:Create(executeBtn, TweenInfo.new(0.05), {Position = originalPos + UDim2.new(0, -4, 0, 0)}):Play()
		task.wait(0.05)
		TweenService:Create(executeBtn, TweenInfo.new(0.05), {Position = originalPos + UDim2.new(0, 4, 0, 0)}):Play()
		task.wait(0.05)
		TweenService:Create(executeBtn, TweenInfo.new(0.05), {Position = originalPos}):Play()
	end
end)

