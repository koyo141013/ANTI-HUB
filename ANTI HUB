local selectedUrl = nil
local scriptButtons = {}
local closed = false
local isExecuting = false

local function setStatus(message, color)
    statusLabel.Text = "● " .. message
    statusLabel.TextColor3 = color or COLORS.Green
end

local function refreshSelection()
    for _, entry in ipairs(scriptButtons) do
        local isSelected = selectedUrl == entry.Data.Url

        tween(entry.Button, TWEEN_FAST, {
            BackgroundColor3 = isSelected and COLORS.AccentDark or COLORS.Button,
        })
        tween(entry.Stroke, TWEEN_FAST, {
            Color = isSelected and COLORS.Accent or COLORS.Border,
        })
        entry.Check.Visible = isSelected
    end
end

local function selectScript(data)
    if isExecuting then return end
    selectedUrl = data.Url
    selectedNameLabel.Text = data.Name
    setStatus("Script selected", COLORS.Green)
    refreshSelection()
end

